# LEGACY PROTOTYPE ONLY. Current browser/mobile: npm run dev:lan, configure the model in the browser.
# Copy to .env. Never put provider keys in the mobile app.
DEV_TOKEN=replace-with-output-of-npm-run-token
HOST=0.0.0.0
PORT=8787

# Use a dedicated Gemini project WITHOUT billing enabled.
# Confirm this in Google AI Studio before setting the flag to true.
# The SDK cannot independently verify your project's billing status.
GEMINI_API_KEY=
GEMINI_BILLING_DISABLED_CONFIRMED=false

# Optional. Enable ONLY with promotional credits, no purchased credits,
# and automatic refills disabled in your TypeSafe account.
TYPESAFE_API_KEY=
JEV_ENABLED=false
JEV_PROMOTIONAL_ONLY_CONFIRMED=false
JEV_AUTO_REFILL_DISABLED_CONFIRMED=false
