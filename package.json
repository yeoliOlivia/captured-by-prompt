{
  "name": "captured-by-prompt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:web": "node --import tsx scripts/start-server.ts",
    "build:mac-photos": "bash scripts/build-mac-photos.sh",
    "test:web": "node --import tsx playground/verify.ts",
    "test:browser": "node --import tsx scripts/verify-browser.ts",
    "test:bundles": "python3 scripts/test_bundle_dataset.py",
    "dev:api": "node --import tsx scripts/start-server.ts",
    "dev:mobile": "npm run start --workspace @captured/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:server",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:api": "npm run typecheck:server",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "dev:lan": "node --import tsx scripts/start-server.ts --lan",
    "dev:legacy-api": "npm run dev --workspace @captured/api",
    "typecheck:server": "tsc --project tsconfig.server.json",
    "build:mobile": "npm exec --workspace @captured/mobile -- expo export --platform ios --output-dir ../../artifacts/local/mobile-export",
    "eval:legacy": "tsx scripts/evaluate.ts",
    "ios": "npm run ios --workspace @captured/mobile",
    "test:studio": "node --import tsx scripts/verify-studio.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "playwright": "1.62.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "@types/react": "~19.2.0",
    "react-dom": "19.2.3"
  }
}
